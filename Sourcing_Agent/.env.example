# ---------------------------------------------------------------------------
# 1688 sourcing agent - configuration
# Copy to .env and fill in. Every value here is optional except the provider
# credentials for whichever route you choose.
# ---------------------------------------------------------------------------

# Which route to 1688 to use: mock | official | aggregator
# "mock" runs the whole workflow against a fixture catalogue with no credentials
# and no cost. Start there, then switch once you have API access.
SOURCING_PROVIDER=mock

# Where the preference profile and saved shortlists are stored.
# SOURCING_HOME=~/.config/sourcing1688

# --------------------------------------------------------------- official API
# Register an application at https://open.1688.com. API namespaces are granted
# per application, so set the *_API values to namespaces your key is approved
# for - the defaults are the cross-border ones and will not suit every account.
# SOURCING_1688_APP_KEY=
# SOURCING_1688_APP_SECRET=
# SOURCING_1688_ACCESS_TOKEN=          # short-lived; from the OAuth2 flow
# SOURCING_1688_SIGN_METHOD=hmac-sha1  # or hmac-sha256 on newer namespaces
# SOURCING_1688_SEARCH_API=com.alibaba.fenxiao.crossborder:product.search.offerSearch
# SOURCING_1688_DETAIL_API=com.alibaba.fenxiao.crossborder:product.search.queryProductDetail
# SOURCING_1688_IMAGE_API=com.alibaba.fenxiao.crossborder:product.image.search

# ------------------------------------------------------ third-party aggregator
# Any licensed 1688 data vendor with a REST API. Field mapping is automatic;
# only set RESULTS_PATH if the vendor nests its result list unusually.
# SOURCING_AGG_BASE_URL=https://example-vendor.com/api/v1
# SOURCING_AGG_API_KEY=
# SOURCING_AGG_KEY_HEADER=x-api-key
# SOURCING_AGG_EXTRA_HEADERS={"x-rapidapi-host": "example.p.rapidapi.com"}
# SOURCING_AGG_SEARCH_PATH=/search
# SOURCING_AGG_DETAIL_PATH=/detail
# SOURCING_AGG_RESULTS_PATH=result.items
# SOURCING_AGG_QUERY_PARAM=keyword

# ------------------------------------------------------------ landed-cost model
# These are assumptions, not quotes. Replace them with your forwarder's rates
# and your own destination's duty treatment.
SOURCING_CURRENCY=USD
SOURCING_FX_CNY_PER_UNIT=7.15        # CNY per 1 unit of SOURCING_CURRENCY
SOURCING_DOMESTIC_FREIGHT_CNY=15     # supplier -> consolidation agent, in China
SOURCING_AGENT_FEE_PCT=5             # sourcing agent commission on goods value
SOURCING_EXPRESS_RATE_PER_KG=11
SOURCING_AIR_RATE_PER_KG=7.5
SOURCING_SEA_RATE_PER_KG=2.2
SOURCING_VOLUMETRIC_DIVISOR=6000
SOURCING_DUTY_PCT=12                 # destination import duty on apparel
SOURCING_IMPORT_TAX_PCT=20           # destination VAT/GST
SOURCING_QC_FEE=30                   # third-party inspection, per order

# --------------------------------------------------------------------- server
# SOURCING_TRANSPORT=stdio            # stdio | http
# SOURCING_HOST=127.0.0.1
# SOURCING_PORT=8765
# SOURCING_HTTP_PATH=/mcp
# Shared secret required on every remote request. Set this before exposing the
# server publicly - without it, anyone with the URL can use your API quota.
# SOURCING_HTTP_BEARER_TOKEN=

# Set to 1 to prevent the connector changing stored preferences (read-only demo).
# SOURCING_READ_ONLY=0

# Tuning
# SOURCING_MAX_RESULTS=40             # results per query
# SOURCING_DETAIL_LIMIT=12            # per-offer detail calls per run (costs money)
# SOURCING_HTTP_TIMEOUT=20
